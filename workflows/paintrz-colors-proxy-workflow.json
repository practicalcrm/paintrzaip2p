      },
      "id": "87ca0211-4a1f-447e-a626-fb64c9c45fb1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        288
      ],
      "webhookId": "65495269-6dab-48f7-a39b-c149da86bd52"
    },
    {
      "parameters": {
        "url": "https://paintdb.com/api/v1/colors",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ $json.query.q || '' }}"
            },
            {
              "name": "limit",
              "value": "={{  $json.query.limit || 100 }}"
            },
            {
              "name": "brand",
              "value": "={{ $json.query.brand || '' }}"
            },
            {
              "name": "family",
              "value": "={{  $json.query.family || '' }}"
            },
            {
              "name": "offset",
              "value": "={{  $json.query.offset || 0 }}"
            }
          ]
        },
        "options": {}
      },
      "id": "036d51cd-8816-43fc-9ba0-5fe88e749c5c",
      "name": "Call PaintDB",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        288
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseHeaders": {
            "entries": [
