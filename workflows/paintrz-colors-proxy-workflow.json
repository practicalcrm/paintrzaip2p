      "typeVersion": 1.1,
      "position": [
        480,
        288
      ]
    },
    {
      "parameters": {
        "content": "## PaintDB CORS proxy\nBrowsers block direct fetch() calls from paintrz.com to paintdb.com (no CORS headers on their end). This workflow runs the request server-side instead, where CORS doesn't apply, and adds the Access-Control-Allow-Origin header so the browser accepts *this* response.\n\nAfter publishing, copy the Production URL from the Webhook node and set it as `PAINTDB_PROXY` in paintrz-app.html's CONFIG.",
        "height": 220,
        "width": 340
      },
      "id": "35e15c0b-2865-4f77-9396-3ecdadb46d1c",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    }
  ],
