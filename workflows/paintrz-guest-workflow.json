    {
      "parameters": {
        "jsCode": "// Looked up by token rather than through guest_link_status, so a render that\n// finishes just after the two hours are up can still be collected. Expiry\n// stops new renders; it should not strand one already paid for.\nconst r = $input.first().json;\nconst row = Array.isArray(r) ? (r[0] || null) : r;\nif (!row || !row.id) throw new Error('unknown link');\nreturn [{ json: {\n  link_id: row.id,\n  renders_left: Math.max(0, (row.render_cap || 0) - (row.renders_used || 0))\n} }];"
      },
      "id": "status_normalize_link",
      "name": "Status Normalize Link",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1660, 300]
    },
    {
      "parameters": {
        "url": "=https://pwkrwyemkjlmjdacelyi.supabase.co/rest/v1/renders?id=eq.{{ $('Guest Status Webhook').item.json.body.render_id }}&guest_link_id=eq.{{ $json.link_id }}&select=status,rendered_photo_url,branded_photo_url",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "options": {}
      },
      "id": "status_get_render",
      "name": "Status Get Render",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-1440, 300],
      "credentials": {
        "httpCustomAuth": { "id": "eXe3HVVzAkOCjsWv", "name": "Paintrz Supabase service role" }
      }
    },
    {
      "parameters": {
        "jsCode": "// Filtering on guest_link_id as well as id is the ownership check: a token can\n// only ever read back renders it produced. Without it, any live token could\n// poll any render id on the platform.\nconst r = $input.first().json;\nconst row = Array.isArray(r) ? (r[0] || null) : r;\nconst link = $('Status Normalize Link').first().json;\nif (!row || !row.status) return [{ json: { status: 'not_found' } }];\nreturn [{ json: {\n  status: row.status,\n  rendered_photo_url: row.rendered_photo_url || null,\n  branded_photo_url: row.branded_photo_url || null,\n  renders_left: link.renders_left\n} }];"
      },
      "id": "status_build_reply",
      "name": "Status Build Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1220, 300]
    },
