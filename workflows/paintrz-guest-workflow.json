    {
      "parameters": {
        "jsCode": "// The guest posts the image itself, because it cannot write to storage. The\n// page downscales to 1600px/JPEG first, so this is a few hundred KB rather\n// than a raw phone photo.\nconst body = $('Guest Render Webhook').first().json.body || {};\nconst link = $('Render Normalize').first().json;\nconst p = $input.first().json;\nconst profile = Array.isArray(p) ? (p[0] || {}) : p;\n\nconst b64 = String(body.photo_base64 || '');\nif (!b64) throw new Error('no photo supplied');\n\n// Namespaced by link, so everything one visit produced stays identifiable\n// after the link is revoked.\nconst stamp = Date.now();\nconst path = 'guest/' + link.link_id + '/' + stamp + '.jpg';\n\nreturn [{\n  json: {\n    link_id: link.link_id,\n    owner_user_id: link.owner_user_id,\n    path: path,\n    public_url: 'https://pwkrwyemkjlmjdacelyi.supabase.co/storage/v1/object/public/photos/' + path,\n    brand_logo_url: profile.brand_logo_url || null,\n    brand_contact: profile.brand_contact || null\n  },\n  binary: {\n    data: { data: b64, mimeType: 'image/jpeg', fileName: stamp + '.jpg' }\n  }\n}];"
      },
